new file mode 100644
--- /dev/null
+++ b/lib/guard-depth.js
@@ -0,0 +1,26 @@
+'use strict';
+
+// Bound recursive walkers before they run (GHSA-vfj7-8cjw-p6xm).
+// Ignore parent/prev links: the parser uses them for back references.
+const MAX_DEPTH = 128;
+const MAX_NODES = 100000;
+const assertDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object' || seen.has(node) ||
+        depth > MAX_DEPTH || ++count > MAX_NODES) {
+      throw new SyntaxError('Brace AST exceeds safe nesting or size limit');
+    }
+    seen.add(node);
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes) || node.nodes.length + pending.length > MAX_NODES) {
+        throw new SyntaxError('Brace AST exceeds safe size limit');
+      }
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+module.exports = { MAX_DEPTH, assertDepth };
